// ═══════════════════════════════════════════════════════════════════════════
// Cloudflare Workers-configuratie voor de MCP-server.
//
// Wat je hier MOET aanpassen bij het opzetten van een nieuwe klant:
//   1. "name"              → kies een unieke naam voor de Worker van deze klant
//   2. "account_id"        → het Cloudflare-account van deze klant
//   3. kv_namespaces "id"  → vul het ID in van de OAUTH_KV-namespace
//                            (aanmaken met: pnpm exec wrangler kv namespace create OAUTH_KV)
// Zie de README, hoofdstuk "Stap 5 — Cloudflare opzetten".
// ═══════════════════════════════════════════════════════════════════════════
{
	"$schema": "node_modules/wrangler/config-schema.json",

	// TODO: hernoem naar de naam van dit klantproject, bv. "acme-crm-mcp"
	"name": "template-neon-db-mcp",

	// TODO: vul het Cloudflare-account-ID van deze klant in.
	// Vind je in het dashboard onder Workers & Pages → rechterkolom "Account ID".
	// Verplicht zodra je met meer dan één Cloudflare-account werkt — en dat is
	// bij een eigen account per klant al snel het geval. Zonder deze regel kiest
	// wrangler zelf een account, of blijft hij wachten op een keuze (wat een
	// AI-agent laat hangen).
	// "account_id": "VERVANG_MIJ_DOOR_HET_ACCOUNT_ID",

	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",

	// nodejs_compat is nodig voor de OAuth-provider en de Neon-driver
	"compatibility_flags": ["nodejs_compat"],

	// De MCP-server draait als Durable Object: elke MCP-sessie krijgt precies
	// één instantie, zodat sessiestatus (o.a. de geregistreerde tools per rol)
	// bewaard blijft tussen requests binnen dezelfde sessie.
	"durable_objects": {
		"bindings": [
			{
				"name": "MCP_OBJECT",
				"class_name": "MyMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MyMCP"]
		}
	],

	// KV-opslag voor de OAuth-provider (tokens, grants, client-registraties).
	// De binding MOET "OAUTH_KV" heten — dat verwacht @cloudflare/workers-oauth-provider.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			// TODO: vervang door het echte KV-namespace-ID (zie README stap 5e).
			// Voor lokaal ontwikkelen (wrangler dev) mag deze placeholder blijven staan.
			"id": "VERVANG_MIJ_DOOR_JOUW_KV_NAMESPACE_ID"
		}
	],

	"observability": {
		"enabled": true
	},

	// Vaste dev-poort zodat de redirect-URI http://localhost:8792/callback
	// in Azure altijd klopt. Wijzig je deze poort, wijzig hem dan ook in Azure
	// én in de README.
	"dev": {
		"port": 8792
	}
}
