# ═══════════════════════════════════════════════════════════════════════════
# Lokale secrets voor `pnpm run dev` (wrangler dev).
#
# Gebruik:
#   1. Kopieer dit bestand naar `.dev.vars` (zonder .example)
#   2. Vul de echte waarden in
#
# LET OP: `.dev.vars` staat in .gitignore en mag NOOIT gecommit worden.
# Voor productie zet je dezelfde waarden als Worker-secrets:
#   pnpm exec wrangler secret put <NAAM>   (zie README, deel A)
# ═══════════════════════════════════════════════════════════════════════════

# ── Microsoft Entra ID (single-tenant App Registration) ────────────────────
# Azure Portal → App registrations → jouw app → Overview
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Azure Portal → App registrations → jouw app → Certificates & secrets
AZURE_CLIENT_SECRET=vul-hier-je-client-secret-in
# Directory (tenant) ID van de Azure-tenant (single-tenant!)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Sleutel voor het ondertekenen van de goedkeurings-cookie.
# Genereer met: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=vul-hier-64-hex-tekens-in

# ═══════════════════════════════════════════════════════════════════════════
# DE DRIE MCP-DATABASEVERBINDINGEN
# ═══════════════════════════════════════════════════════════════════════════
#
# ⚠ Ontbreekt er één, dan WEIGERT de server élke tool-aanroep. Dat is opzet:
#   er is bewust geen terugval op een ruimere verbinding, want dat is de
#   klassieke fail-open — de beveiliging verdwijnt zonder dat er iets stukgaat.
#
# De volledige gebruiker (de eigenaar van de database) hoort hier NIET: die is
# van de migraties en de applicatie van de klant, en wordt door geen enkele
# MCP-tool gebruikt.
#
# Aanmaken: draai sql/02-mcp-neon-rollen.sql als eigenaar in de Neon-console.
# Gebruik de POOLED host (-pooler) en een alfanumeriek wachtwoord (scheelt
# URL-encoding).

# Rol `mcp_lezer` — uitsluitend SELECT, draait read-only.
DATABASE_URL_LEZER=postgresql://mcp_lezer:wachtwoord@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Rol `mcp_schrijver` — SELECT, INSERT en UPDATE. Nooit DELETE, nooit DDL.
DATABASE_URL_SCHRIJVER=postgresql://mcp_schrijver:wachtwoord@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Rol `mcp_service` — leest de rechten, bindt de Entra-oid, werkt de
# schrijfteller bij. Meer niet; hier draait nooit een aangeleverde query op.
DATABASE_URL_SERVICE=postgresql://mcp_service:wachtwoord@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Alleen voor de databasetests ───────────────────────────────────────────
# Zet dit op 1 om test/privileges.db.test.ts te activeren. Doe dat UITSLUITEND
# tegen een Neon-testbranch: die tests schrijven en tellen.
# MCP_TEST_BRANCH=1
# De eigenaar van de TESTBRANCH (nooit productie): alleen voor het begrenzingenblok,
# dat een tijdelijke rol aanmaakt en weer opruimt.
# MCP_TEST_EIGENAAR_URL=
